---
// Rendered on demand so routes that return an empty 404 (blog/[slug]) can render it in-process.
// A prerendered 404 is fetched over HTTP instead, which fails inside the Vercel function and leaves a blank page.
export const prerender = false;

import BaseLayout from '@/layouts/BaseLayout.astro';
import {
  Button,
  ErrorBlock,
  ErrorBlockActions,
  ErrorBlockCode,
  ErrorBlockDescription,
  ErrorBlockMessage,
} from '@noactionjaxn/another-react-tailwind-component-library';
---

<BaseLayout title="404 - Not Found" description="404 Error — this page was not found">
  <ErrorBlock>
    <ErrorBlockCode>404</ErrorBlockCode>
    <ErrorBlockMessage asChild>
      <h1>Page not found</h1>
    </ErrorBlockMessage>
    <ErrorBlockDescription>Sorry, we couldn't find the page you're looking for.</ErrorBlockDescription>
    <ErrorBlockActions>
      <Button asChild>
        <a href="/">Go back home</a>
      </Button>
    </ErrorBlockActions>
  </ErrorBlock>
</BaseLayout>
